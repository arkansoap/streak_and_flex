# Copier en `.env` à la racine du repo. Lu par Django (python-dotenv) et docker compose.

# --- Base de données -------------------------------------------------------
POSTGRES_PASSWORD=streak
POSTGRES_PORT=5444
# Django lit DATABASE_URL en priorité ; sinon valeur par défaut = la base Docker de dev.
DATABASE_URL=postgres://streak:streak@localhost:5444/streak

# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En prod : https://streak.mondomaine.fr (séparés par des virgules)
DJANGO_CSRF_TRUSTED_ORIGINS=
TZ=Europe/Paris

# --- Google Agenda (facultatif) ---------------------------------------------
# Marche à suivre complète : docs/AGENDA.md. Sans ces deux valeurs, la page Agenda
# explique que Google n'est pas configuré et tout le reste fonctionne.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresse publique de l'app (liens dans les événements, retour OAuth). Prod : https://streak.mondomaine.fr
APP_URL=http://localhost:5180
# Nom du calendrier dédié créé dans ton compte Google.
GOOGLE_CALENDAR_NAME=flex_and_streak

# --- Prod uniquement (docker-compose.prod.yml) ------------------------------
# Port hôte sur lequel nginx écoute ; un reverse proxy TLS (Caddy, nginx, Traefik) se met devant.
WEB_PORT=8020
